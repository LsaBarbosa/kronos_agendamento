{
	admin off
	auto_https off
}

{$APP_HOST}:8443 {
	tls /run/staging/tls.crt /run/staging/tls.key
	@application_backend path /api/* /oauth2/* /login/* /logout
	handle @application_backend {
		reverse_proxy app:8080 {
			header_up -Forwarded
			header_up Host {http.request.host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port {$PUBLIC_HTTPS_PORT}
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

{$KEYCLOAK_HOST}:8443 {
	tls /run/staging/tls.crt /run/staging/tls.key
	reverse_proxy keycloak:8080 {
		header_up -Forwarded
		header_up Host {http.request.host}
		header_up X-Forwarded-Host {http.request.host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port {$PUBLIC_HTTPS_PORT}
		header_up X-Forwarded-For {http.request.remote.host}
	}
}

# Unknown Host values are never routed to either application.
:8443 {
	tls /run/staging/tls.crt /run/staging/tls.key
	respond 421
}
