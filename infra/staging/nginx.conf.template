worker_processes auto;
pid /tmp/nginx/nginx.pid;
error_log /dev/stderr notice;

events {
    worker_connections 1024;
}

http {
    map_hash_bucket_size 128;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    server_tokens off;
    keepalive_timeout 65;
    error_page 421 =421 @empty_421;
    client_body_temp_path /tmp/nginx/client_body;
    proxy_temp_path /tmp/nginx/proxy_temp;
    fastcgi_temp_path /tmp/nginx/fastcgi_temp;
    uwsgi_temp_path /tmp/nginx/uwsgi_temp;
    scgi_temp_path /tmp/nginx/scgi_temp;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    map "$ssl_server_name|$host" $edge_host_pair_allowed {
        default 0;
        "${APP_HOST}|${APP_HOST}" 1;
        "${KEYCLOAK_HOST}|${KEYCLOAK_HOST}" 1;
    }

    server {
        listen 8443 ssl default_server;
        server_name _;
        ssl_certificate /run/staging/tls.crt;
        ssl_certificate_key /run/staging/tls.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        error_page 403 =421 @empty_421;
        error_page 421 =421 @empty_421;

        location / {
            deny all;
        }

        location @empty_421 {
            root /etc/nginx;
            try_files /empty-response =421;
        }
    }

    server {
        listen 8443 ssl;
        server_name ${APP_HOST};
        ssl_certificate /run/staging/tls.crt;
        ssl_certificate_key /run/staging/tls.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        if ($edge_host_pair_allowed = 0) { return 421; }

        location @empty_421 {
            root /etc/nginx;
            try_files /empty-response =421;
        }

        proxy_http_version 1.1;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Host $host;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port ${PUBLIC_HTTPS_PORT};
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-Server "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_redirect off;

        location = /api {
            proxy_pass http://app:8080;
        }
        location ^~ /api/ {
            proxy_pass http://app:8080;
        }
        location ^~ /oauth2/ {
            proxy_pass http://app:8080;
        }
        location ^~ /login/ {
            proxy_pass http://app:8080;
        }
        location = /logout {
            proxy_pass http://app:8080;
        }
        location ^~ /logout/ {
            proxy_pass http://app:8080;
        }
        location / {
            root /srv;
            try_files $uri $uri/ /index.html;
        }
    }

    server {
        listen 8443 ssl;
        server_name ${KEYCLOAK_HOST};
        ssl_certificate /run/staging/tls.crt;
        ssl_certificate_key /run/staging/tls.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        if ($edge_host_pair_allowed = 0) { return 421; }

        location @empty_421 {
            root /etc/nginx;
            try_files /empty-response =421;
        }

        proxy_http_version 1.1;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Host $host;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port ${PUBLIC_HTTPS_PORT};
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-Server "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_redirect off;

        location / {
            proxy_pass http://keycloak:8080;
        }
    }
}
