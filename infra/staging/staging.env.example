# Non-secret shape only. Replace every domain, path, project identifier and
# image tag; populate secrets externally, set file mode 0600, then run preflight.
# The current preparation intentionally rejects non-loopback binds.
STAGING_PROJECT=agendamento-staging
APP_HOST=app.example.invalid
KEYCLOAK_HOST=id.example.invalid
STAGING_HTTPS_PORT=443
STAGING_BIND_ADDRESS=127.0.0.1
APP_ORIGIN=https://app.example.invalid:443
OIDC_ISSUER_ORIGIN=https://id.example.invalid:443
OIDC_ISSUER_URI=https://id.example.invalid:443/realms/agendamento
OIDC_AUTHORIZATION_URI=https://id.example.invalid:443/realms/agendamento/protocol/openid-connect/auth
OIDC_TOKEN_URI=http://keycloak:8080/realms/agendamento/protocol/openid-connect/token
OIDC_JWK_SET_URI=http://keycloak:8080/realms/agendamento/protocol/openid-connect/certs
OIDC_USER_INFO_URI=http://keycloak:8080/realms/agendamento/protocol/openid-connect/userinfo
OIDC_CLIENT_ID=agendamento-backend
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://app.example.invalid:443/login/oauth2/code/keycloak
APP_FRONTEND_URL=https://app.example.invalid:443/admin

# Use two disjoint project-specific subnets and one trusted proxy /32.
STAGING_SUBNET=10.250.1.0/24
STAGING_INGRESS_SUBNET=10.250.2.0/24
STAGING_PROXY_IP=10.250.1.254
STAGING_PROXY_CIDR=10.250.1.254/32

# Supply externally managed, readable files. Realm client secret must equal
# OIDC_CLIENT_SECRET. TLS dir must contain tls.crt and tls.key.
STAGING_TLS_DIR=/secure/staging/tls
STAGING_REALM_FILE=/secure/staging/agendamento-realm.json
STAGING_POSTGRES_IMAGE=postgres:16.13-alpine@sha256:4e6e670bb069649261c9c18031f0aded7bb249a5b6664ddec29c013a89310d50
STAGING_KEYCLOAK_IMAGE=agendamento-staging-keycloak:replace-with-release-tag
STAGING_BACKEND_IMAGE=agendamento-staging-backend:replace-with-release-tag
STAGING_EDGE_IMAGE=agendamento-staging-edge:replace-with-release-tag

STAGING_APP_DB_PASSWORD=
STAGING_APP_DB_MIGRATOR_PASSWORD=
STAGING_KEYCLOAK_DB_PASSWORD=
STAGING_KEYCLOAK_BOOTSTRAP_USER=
STAGING_KEYCLOAK_BOOTSTRAP_PASSWORD=
PUBLIC_BOOKING_HMAC_ACTIVE_KEY_ID=
PUBLIC_BOOKING_HMAC_KEYS=
