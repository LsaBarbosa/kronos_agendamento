# Test-only control image. Never used by Compose or the Keycloak runtime.
ARG DEBIAN_BASE=debian:trixie-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4
ARG DEBIAN_SNAPSHOT=20261028T183000Z

FROM ${DEBIAN_BASE}
ARG DEBIAN_SNAPSHOT

RUN rm -f /etc/apt/sources.list.d/* && \
    printf '%s\n' \
      "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}/ trixie main" \
      > /etc/apt/sources.list && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      openjdk-21-jre-headless=21.0.12.1+1-1~deb13u1 && \
    test "$(dpkg-query -W -f='${Version}' openjdk-21-jre-headless)" = '21.0.12.1+1-1~deb13u1' && \
    mkdir -p /usr/share/keycloak-scan-control && \
    printf '%s\n' \
      'Purpose=isolated Debian 13 Trivy advisory-coverage control only' \
      'ExpectedOS=Debian 13/Trixie' \
      'ExpectedPackage=openjdk-21-jre-headless=21.0.12.1+1-1~deb13u1' \
      'ExpectedAdvisory=CVE-2026-91415' \
      > /usr/share/keycloak-scan-control/CONTROL-METADATA.txt && \
    rm -rf /var/lib/apt/lists/*
