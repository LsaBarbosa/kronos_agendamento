        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (worker) (agd_workers_backlog_oldest_age_seconds)",
          "instant": true,
          "legendFormat": "{{worker}}"
