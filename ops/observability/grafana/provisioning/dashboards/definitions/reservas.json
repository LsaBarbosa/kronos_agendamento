{
  "id": null,
  "uid": "agd052-reservas",
  "title": "AGD-052 · Reservas",
  "description": "Dashboards locais AGD-052, vinculados ao contrato compartilhado de métricas.",
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Comandos por canal e resultado",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel,result) (rate(agd_appointments_booking_commands_total[5m]))",
          "instant": false,
          "legendFormat": "{{channel}} · {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Efeitos confirmados por canal/tipo",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel,effect) (rate(agd_appointments_booking_effects_confirmed_total[5m]))",
          "instant": false,
          "legendFormat": "{{channel}} · {{effect}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "text",
      "title": "Limites e interpretação",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "options": {
        "mode": "markdown",
        "content": "`replay`, conflito e rejeição não são efeitos confirmados. Counters são locais ao processo e podem reiniciar; agregamos `rate` entre instâncias. Métrica não altera decisão de reserva."
      },
      "transparent": true
    },
    {
      "id": 4,
      "type": "table",
      "title": "Alertas locais em firing",
      "description": "Tabela vazia significa que não há alerta local firing; não representa zero em métricas de negócio.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "instant": true,
          "legendFormat": "{{worker}}",
          "format": "table"
